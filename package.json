{
  "name": "birthday-greet",
  "description": "A scroll-driven interactive birthday site in five scenes — envelope, card, record, photo wall, letter. Ships with placeholders: swap in your own text, photos and music.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit --force",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "licenses": "node scripts/license-check.mjs",
    "assets": "node scripts/make-assets.mjs",
    "textures": "node scripts/fetch-textures.mjs",
    "vendor:magicui": "node scripts/vendor-magicui.mjs",
    "song": "node scripts/make-placeholder-audio.mjs"
  },
  "dependencies": {
    "@fontsource/great-vibes": "^5.2.9",
    "@fontsource/quicksand": "^5.2.8",
    "@fontsource/the-girl-next-door": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "oxlint": "^1.24.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
